[Unit]
Description=telegraff scheduled transfer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=telegraff
Group=telegraff
ExecStart=/usr/local/bin/telegraff agent --config /etc/telegraff/agent.toml
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
